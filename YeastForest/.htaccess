# Bosque Filogenético · config Apache (opcional pero recomendado)
# Va junto a index.html. Requiere AllowOverride All para esa carpeta.
AddType application/javascript .js
# Compresión: los datos (JS con JSON adentro) bajan ~80%. Necesita mod_deflate.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json text/plain text/html text/css image/svg+xml
</IfModule>
# Caché: los datos llevan ?v=<fecha de preparación>, así que se pueden cachear sin riesgo. Necesita mod_expires.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
Options -Indexes
