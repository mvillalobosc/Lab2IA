# Phily — Apache: servir index.html para cualquier ruta bajo /Phyli/
# Habilita URLs con el árbol escrito en la ruta, por ejemplo:
#   https://kalgan.diinf.usach.cl/Phyli/(Homo:1,(Mus:1,Rattus:1)Rodentia:1);
#
# (La forma con # ya funciona SIN esto:  .../Phyli/#(A:1,B:1); )

RewriteEngine On
RewriteBase /Phyli/

# No reescribir archivos ni carpetas que existan de verdad (index.html, .css, imágenes…)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Todo lo demás -> la app
RewriteRule ^ index.html [L]

# Permitir paréntesis/caracteres del Newick en la ruta
AllowEncodedSlashes NoDecode
